AddDefaultCharset UTF-8

# Block direct web access to sensitive files. These are only ever loaded via
# require/include — never requested directly — so denying them protects the admin
# hash and reCAPTCHA secret if the PHP handler is ever misconfigured.
<FilesMatch "^config\.php$">
    Require all denied
</FilesMatch>
<FilesMatch "\.(log|md|json)$">
    Require all denied
</FilesMatch>
RedirectMatch 403 ^/(includes|libs)/.*$

<IfModule mod_rewrite.c>

RewriteEngine On
# Set this to match base_path in config.php (e.g. / or /blog/)
RewriteBase /

# Pass real files and directories through
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Sitemap and robots
RewriteRule ^sitemap\.xml$           sitemap.php     [L]
RewriteRule ^robots\.txt$            robots.php      [L]

# RSS feed
RewriteRule ^feed\.xml$              feed.php        [L]

# Admin panel (preserves ?action=, ?type=, etc.)
RewriteRule ^admin/?$                admin.php       [QSA,L]

# Blog index (preserves ?page=N)
RewriteRule ^blog/?$                 blog.php        [QSA,L]

# Contact page
RewriteRule ^contact/?$              contact.php     [QSA,L]

# Individual post
RewriteRule ^post/([^/]+)/?$         post.php?slug=$1   [QSA,L]

# Store index and individual product
RewriteRule ^store/?$                store.php           [L]
RewriteRule ^product/([^/]+)/?$      product.php?slug=$1 [QSA,L]

# Static page
RewriteRule ^page/([^/]+)/?$         page.php?slug=$1   [QSA,L]

# Tag filter
RewriteRule ^tag/([^/]+)/?$          archive.php?tag=$1    [QSA,L]

# Category filter
RewriteRule ^category/([^/]+)/?$     archive.php?category=$1  [QSA,L]

# Archive index
RewriteRule ^archive/?$              archive.php     [L]

</IfModule>

ErrorDocument 404 /404.php
ErrorDocument 500 /500.php
